# Python
**/__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.venv-ref/
venv/
env/

# Secrets & environment files
.env
.env.*
!.env.example

# Logs & temporary files
*.log
*.tmp
~$*
*.bak

# IDE / OS private state
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Installer / npm layer
installer/npm/node_modules/
installer/npm/*.tgz
# Generated by the prepack step right before `npm pack` (regenerated every
# time — never commit these)
installer/npm/skill/
installer/npm/tools/
installer/npm/LICENSE
installer/npm/CHANGELOG.md

# Local AutoCAD / MCP runtime artifacts (generated output — never skill source)
*.dwg
*.dxf
*.dwt
*.bak
*.dwl
*.dwl2
screenshots/
checkpoints/
projects/

# Local engineering reference artifacts (user libraries and generated
# indexes live outside the repo and must never be committed)
references.json
.index/
