{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "engineering-cad-agent/element",
  "title": "Design Element",
  "description": "A CAD entity with its engineering intent and dependencies",
  "type": "object",
  "required": ["element_id", "handle", "description", "layer", "intent"],
  "properties": {
    "element_id": { "type": "string", "description": "e.g. WALL-N-01, DOOR-D01" },
    "handle": { "type": "string", "description": "AutoCAD entity handle (hex string)" },
    "object_type": { "type": "string", "description": "e.g. AcDbPolyline, AcDbLine" },
    "description": { "type": "string" },
    "layer": { "type": "string" },
    "intent": {
      "type": "string",
      "description": "WHY this element was created — the engineering reason"
    },
    "requirement_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "REQ-NNN identifiers this element satisfies"
    },
    "constraint_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "CON-NNN constraints this element must respect"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "element_ids of elements this element depends on"
    },
    "dependents": {
      "type": "array",
      "items": { "type": "string" },
      "description": "element_ids of elements that depend on this element"
    },
    "position_notes": {
      "type": "string",
      "description": "Human-readable description of position and dimensions"
    },
    "verified": { "type": "boolean", "default": false },
    "created_at": { "type": "string", "format": "date-time" },
    "phase": { "type": "string" }
  }
}
